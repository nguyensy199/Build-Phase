{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BBox2DTrackingExportSchema",
  "type": "object",
  "required": ["info", "classes", "frames"],
  "properties": {
    "info": {
      "type": "object",
      "required": ["sample_id", "type", "fps", "width", "height", "frame_count", "bbox_format", "frame_index_base"],
      "properties": {
        "sample_id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["video", "image_sequence"] },
        "fps": { "type": "number", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "frame_count": { "type": "integer", "minimum": 1 },
        "bbox_format": { "type": "string", "enum": ["xywh_pixel_topleft"] },
        "frame_index_base": { "type": "integer", "enum": [0] },
        "exported_at": { "type": "string", "format": "date-time" },
        "model_version": { "type": "string" },
        "tracker": { "type": "string" }
      }
    },
    "classes": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frame", "objects"],
        "properties": {
          "frame": { "type": "integer", "minimum": 0 },
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["track_id", "class", "bbox"],
              "properties": {
                "track_id": { "type": "integer", "minimum": 1 },
                "class": { "type": "string" },
                "bbox": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 4,
                  "maxItems": 4,
                  "description": "[x, y, width, height] in original pixel coordinates"
                },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "source": { "type": "string", "enum": ["auto", "manual", "edited", "interpolated"] }
              }
            }
          }
        }
      }
    }
  }
}
