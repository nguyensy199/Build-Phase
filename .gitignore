# ==============================================================================
# 3. DỮ LIỆU MEDIA & GROUND TRUTH THỰC TẾ (Không đẩy video/ảnh nặng & dữ liệu thô)
# ==============================================================================
# Bỏ qua toàn bộ nội dung trong thư mục data/, chỉ giữ lại file .gitkeep để duy trì cấu trúc
/data/*
!/data/raw
!/data/raw/.gitkeep
!/data/frames
!/data/frames/.gitkeep
!/data/detections
!/data/detections/.gitkeep
!/data/exports
!/data/exports/.gitkeep
/data/temp/

